# ==============================================================================
# NCB DIGITAL COMPANION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Cloud Configuration (Optional - falls back to local SQLite if left empty)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 2. Server Configuration
PORT=8000
HOST=0.0.0.0
# When deployed on Render / Hugging Face, put your public domain here:
# BASE_URL=https://ncb-drug-test.onrender.com
BASE_URL=http://localhost:8000

# 3. Cryptographic Signature Secret
SIGNATURE_SECRET=ncb-digital-custody-salt-9821-secure

